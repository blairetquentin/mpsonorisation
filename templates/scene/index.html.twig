{% extends 'base.html.twig' %}

{% block title %}mes scene{% endblock %}

{% block body %}
<div class="container py-5">
    <h1 class="mb-4">Mes Scenes</h1>
    <div>
        {% for scene in scenes %}
            <a href="{{ path('app_scene_modif', {id: scene.id}) }}">
                <div class="card" style="width: 18rem;">
                    <div class="card-body">
                        <p class="card-text">{{ scene.nomEvenement }}</p>
                        <p class="card-text">{{ scene.dateEvenement|date('d/m/Y') }}</p>
                        <p class="card-text">{{ scene.nomArtiste }}</p>
                    </div>
                </div>
            {% endfor %}
        </a>
    </div>
{% endblock %}