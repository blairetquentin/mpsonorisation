{% extends 'base.html.twig' %}

{% block title %}creation scene{% endblock %}

{% block body %}
<div class="container py-5">
    <h1 class="mb-4">Creation Scene</h1>

{{ form_start(form, {'attr': {'data-turbo': 'false'}}) }}
    {{ form_row(form.nomEvenement) }}
    {{ form_row(form.dateEvenement) }}
    {{ form_row(form.nomArtiste) }}

    <div id="instruments">
        <h2>Ajouter un nouvel instrument :</h2>
        <select name="instruments[0]">
            <option value="">-- Aucun --</option>
            {% for instrument in instruments %}
                <option value="{{ instrument.id }}">{{ instrument.libelle }}</option>
            {% endfor %}
        </select>
        <input type="text" name="nomMusicien[0]" placeholder="Nom musicien">
    </div>

    <button type="button" id="add_instrument" class="btn btn-secondary mt-2 d-block">
        + Ajouter instrument
    </button>

    <button type="submit" name="action" value="ajouter" class="btn btn-primary mt-2">
        Ajouter les instruments
    </button>

    <h3 class="mt-4">Recap de vos instruments :</h3>
    <table class="tableau-musicien table-bordered mt-3">
        <thead>
            <tr>
                <th scope="col">Nom du musicien</th>
                <th scope="col">Nom de l'instrument</th>
                <th scope="col">Équipement</th>
                <th scope="col">Supprimer</th>
            </tr>
        </thead>
        <tbody>
        {% if scene.id %}
            {% for element in scene.elementScenes %}
            <tr>
                <td>{{ element.nomMusicien }}</td>
                <td>{{ element.instrument.libelle }}</td>
                <td>
                    <select name="equipement[{{ element.id }}]" class="form-select form-select-sm">
                        <option value="">-- Aucun --</option>
                        {% for equipement in equipements %}
                            <option value="{{ equipement.id }}"
                                {% if element.equipement and element.equipement.id == equipement.id %}
                                    selected
                                {% endif %}>
                                {{ equipement.libelle }}
                            </option>
                        {% endfor %}
                    </select>
                </td>
                <td>
                    <form method="POST" action="{{ path('app_scene_delete', { id: element.id }) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_element_' ~ element.id) }}">
                        <button type="submit" class="btn btn-danger btn-sm">✕</button>
                    </form>
                    
                </td>
            </tr>
            {% endfor %}
        {% endif %}
        </tbody>
    </table>

    <button type="submit" name="action" value="equipement" class="btn btn-success mt-2">
        Sauvegarder les équipements
    </button>

{{ form_end(form) }}

</div>
{% endblock %}