{% extends 'base.html.twig' %}

{% block title %}creation scene{% endblock %}

{% block body %}
<div class="container py-5">
    <h1 class="mb-4">Creation Scene</h1>

{{ form_start(form, {'attr': {'data-turbo': 'false'}}) }}
    {{ form_row(form.nomEvenement) }}
    {{ form_row(form.dateEvenement) }}
    {{ form_row(form.nomArtiste) }}

    <div id="instruments">
        <h2>Ajouter un nouvel instrument :</h2>
        <div class="instrument-row">
            <input type="text" name="instruments[0]" id="recherche-instrument"  placeholder="Rechercher un instrument..."  autocomplete="off">
            <input type="hidden" name="instrumentsId[0]" id="instrument-id-0">
            <ul id="suggestions-instrument" class="list-group position-absolute w-100 z-3" style="display:none;"></ul>
            <input type="text" name="nomMusicien[0]" placeholder="Nom musicien">
        </div>
    </div>

    <button type="button" id="add_instrument" class="btn btn-secondary mt-2 d-block">
        + Ajouter instrument
    </button>
    <button type="submit" name="action" value="ajouter" class="btn btn-primary mt-2">
        Valider la scene
    </button>
{{ form_end(form) }}

</div>
{% endblock %}
